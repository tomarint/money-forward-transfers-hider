{
  "name": "money-forward-transfers-hider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:edge": "wxt -b edge --mv3",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "pnpm run build:chrome && pnpm run build:edge && pnpm run build:firefox",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "pnpm run zip:chrome && pnpm run zip:edge && pnpm run zip:firefox",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run zip && pnpm run test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@wxt-dev/i18n": "0.2.7"
  }
}
